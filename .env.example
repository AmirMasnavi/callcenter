DB_USER=callcenter
DB_PASSWORD=replace-with-a-long-random-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-temporary-password
ADMIN_NAME=مدیر سامانه
DEMO_USERS_ENABLED=true
DEMO_PASSWORD=Demo12345!
APP_PORT=8088
COOKIE_SECURE=false
# Comma-separated. Must contain the origin the browser loads the app from.
# 8088 = the compose stack (APP_PORT); 5173 = the Vite dev server.
CORS_ALLOWED_ORIGINS=http://localhost:8088,http://localhost:5173
# Dev only: seed a few weeks of sample reports when the reports table is empty.
MOCK_DATA_ENABLED=false
